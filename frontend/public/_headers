# Content-Security-Policy (Auth round 2): the session token lives in localStorage, so the
# main defence against a script injection reading it is stopping injected script from
# running at all. script-src 'self' does that (the Vite build emits no inline scripts).
# style-src needs 'unsafe-inline' for React style={{}} attributes. connect-src is
# `https:` rather than the exact API origin because VITE_API_URL is a per-deploy
# build setting; to tighten it, replace `https:` with your API origin
# (e.g. https://api.passthrough.dev). Paystack checkout is a top-level redirect,
# not an embedded script/frame, so it needs no entry here.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/v/*
  X-Robots-Tag: noindex, nofollow

# Employer-lead email links (confirm / remove / rejoin) carry a signed token in the query string:
# same treatment — never indexed, never cached, never leaked in a Referer header.
/employer/*
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Partner pages are reached by a bearer token in the query string: never cache them,
# never index them, never leak the URL (token included) in a Referer header.
/partner/*
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Round 5: /partner/apply is the program's PUBLIC page (it carries no token), so it must be
# indexable and cacheable like any other marketing page. The block above would otherwise
# noindex it, hiding the only place a prospective partner can find the program. `!` detaches
# a header set by the broader rule.
/partner/apply
  ! X-Robots-Tag
  ! Cache-Control
  ! Referrer-Policy
  Referrer-Policy: strict-origin-when-cross-origin

# Round 6: the program terms page is public and tokenless too — same treatment as /partner/apply.
/partner/terms
  ! X-Robots-Tag
  ! Cache-Control
  ! Referrer-Policy
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable
