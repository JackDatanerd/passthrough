 frontend/src/hooks/useReferralCapture.js   | 10 ++++
 frontend/src/pages/PartnerDashboard.jsx    | 36 +++++++++++++-
 frontend/src/pages/ScanResult.jsx          | 19 ++++++--
 frontend/src/pages/admin/AdminPartners.jsx | 21 ++++++--
 5 files changed, 125 insertions(+), 17 deletions(-)

