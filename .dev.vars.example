# Copy this file to .dev.vars (gitignored) for local `wrangler dev`.
# In production, each of these is set via: wrangler secret put VAR_NAME
# Workers do not load .env files — this is the only mechanism for secrets.

# Local dev: wrangler.toml [vars] says NODE_ENV="production", which masks error messages and puts
# every local request in one 'unknown' client-IP bucket. This overrides it for `wrangler dev` only.
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...           # service_role key — server only, never the anon key

# Auth
JWT_SECRET=replace_with_minimum_32_char_random_string

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Paystack
PAYSTACK_SECRET_KEY=sk_test_...

# Resend (replaces SMTP/Nodemailer)
RESEND_API_KEY=re_...

npx wrangler secret put PAYSTACK_PUBLIC_KEY
npx wrangler secret put PAYSTACK_SECRET_KEY


# Local-only overrides (optional — leave unset to use wrangler.toml [vars])
# FRONTEND_URL=http://localhost:3000
# PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/success

# Optional — see DEPLOYMENT.md "Optional secrets".
# Paystack's webhook source IPs (comma-separated); unset = IP not checked.
# PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220
# Resend webhook signing secret (whsec_…) — bounce / spam-complaint events suppress employer leads.
# RESEND_WEBHOOK_SECRET=whsec_replace_me
# Shared secret with the /v/:code Pages Function for link previews.
# VERIFY_PREVIEW_KEY=replace_with_random_hex
# Turnstile bot challenge on the employer-lead form; unset = off. Pair with VITE_TURNSTILE_SITE_KEY
# in the frontend. Cloudflare's always-passes TEST secret:
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Public origin of this Worker for the List-Unsubscribe URL; unset = taken from the request.
# API_ORIGIN=http://localhost:8787
# Keyed hash for the employer do-not-contact list (unset = plain SHA-256). See DEPLOYMENT.md before changing.
# SUPPRESSION_HASH_KEY=replace_with_random_hex
# SUPPRESSION_HASH_KEY_PREVIOUS=
# Restrict the admin panel to these IPs / CIDR ranges (comma-separated; a bare IPv6 address matches its /64).
# ADMIN_ALLOWED_IPS=203.0.113.7,198.51.100.0/24,2001:db8:abcd::/48
# Admin session age cap in hours (default 24, 0 = off) and password step-up window in minutes (default 0 = off).
# ADMIN_SESSION_MAX_HOURS=24
# ADMIN_STEP_UP_MINUTES=10
# Out-of-band owner alerts (https incoming-webhook URL; Slack/Discord/Teams style).
# ALERT_WEBHOOK_URL=
# Deep health check for /healthz (send it in the X-Health-Key header).
# HEALTH_CHECK_KEY=replace_with_random_hex
# How long a rate-limit Durable Object call may take before the limiter fails open (default 3000 ms).
# RATE_LIMIT_DO_TIMEOUT_MS=3000

# More optional settings the code reads (all off / defaulted when unset — see DEPLOYMENT.md):
# Separate signing key for employer-lead confirm / remove / unsubscribe links (falls back to JWT_SECRET).
# Partner tax IDs are stored AES-256-GCM encrypted. 32 random bytes, base64:  openssl rand -base64 32
# Do not lose or change it without re-sealing: a tax ID sealed under one key cannot be read with another.
# TAX_ID_ENCRYPTION_KEY=

# LEAD_LINK_SECRET=replace_with_random_hex
# LEAD_LINK_SECRET_PREVIOUS=
# Old Paystack key, ONLY while rotating PAYSTACK_SECRET_KEY (so retried webhooks still verify).
# PAYSTACK_SECRET_KEY_PREVIOUS=
# Extra browser origins CORS allows besides FRONTEND_URL (comma-separated, no trailing slashes).
# CORS_EXTRA_ORIGINS=https://www.usepassthrough.com
# Partner payouts: minimum payout in cents, refund-window hold in days, payout-details hold in hours (default 48).
# COMMISSION_MIN_PAYOUT_CENTS=0
# COMMISSION_HOLD_DAYS=0
# PAYOUT_DETAILS_HOLD_HOURS=48
# Free scans per IP per day across all accounts (0 disables) and the breached-password check ("off" disables).
# SCAN_IP_DAILY_CAP=15
# PWNED_PASSWORDS_CHECK=on
# Automatic refunds for duplicate / undeliverable payments ("false" = alert only).
# AUTO_REFUND_DUPLICATES=true
# AUTO_REFUND_UNDELIVERABLE=true
# Paid sales the hourly refund-reconciliation sweep checks per run (default 20, max 100).
# REVERSAL_CHECKS_PER_RUN=20
# TESTING ONLY: IPs (comma-separated) that skip every rate limit. Delete before real traffic.
# RATE_LIMIT_BYPASS_IPS=
# Optional tuning (all have defaults; see DEPLOYMENT.md "Optional tuning variables").
# SUPPORT_EMAIL=support@usepassthrough.com
# (frontend build: VITE_SUPPORT_EMAIL overrides the address shown on the site; see frontend/src/lib/support.js)
# REFERRAL_MIN_PRICE_PCT=10
# REFERRAL_VELOCITY_ALERT=10
# ARCHIVED_LEAD_PURGE_SUPPRESSES=false
# CLAUDE_USD_PER_MTOK_INPUT=
# CLAUDE_USD_PER_MTOK_OUTPUT=
# SUPABASE_TIMEOUT_MS=25000
