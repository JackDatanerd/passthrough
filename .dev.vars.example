# Copy this file to .dev.vars (gitignored) for local `wrangler dev`.
# In production, each of these is set via: wrangler secret put VAR_NAME
# Workers do not load .env files — this is the only mechanism for secrets.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...           # service_role key — server only, never the anon key

# Auth
JWT_SECRET=replace_with_minimum_32_char_random_string

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Paystack
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

# Resend (replaces SMTP/Nodemailer)
RESEND_API_KEY=re_...

# Local-only overrides (optional — leave unset to use wrangler.toml [vars])
# FRONTEND_URL=http://localhost:3000
# PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/success

# Optional — see DEPLOYMENT.md "Optional secrets".
# Paystack's webhook source IPs (comma-separated); unset = IP not checked.
# PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220
# Shared secret with the /v/:code Pages Function for link previews.
# VERIFY_PREVIEW_KEY=replace_with_random_hex
