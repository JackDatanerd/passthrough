{
  "name": "passthrough-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev":        "wrangler dev --port 4000",
    "deploy":     "wrangler deploy",
    "seed":       "node supabase/seed.js",
    "cf-typegen": "wrangler types",
    "test":       "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint":       "node scripts/lint-undefined.cjs",
    "predeploy":  "npm run lint && npm test"
  },
  "dependencies": {
    "@supabase/supabase-js":  "^2.39.0",
    "bcryptjs":               "^2.4.3",
    "docx":                   "8.5.0",
    "hono":                   "^4.3.0",
    "jszip":                  "^3.10.1",
    "unpdf":                  "^0.11.0",
    "zod":                    "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/puppeteer":  "^1.1.0",
    "vitest":                 "^4.1.10",
    "wrangler":               "^3.50.0"
  }
}
